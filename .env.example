# PoliTo Recap settings, in .env next to docker-compose.yml. The setup makes it from this
# file and fills in who writes the notes (docker compose run --rm setup); the rest you edit
# by hand, then docker compose up -d. An empty value means the default.

# ---- Who writes the notes --------------------------------------------------------------
# claude | codex | antigravity | openai | openrouter | gemini | mistral | deepseek | ollama |
# lmstudio | compatible
#   claude      Claude Code, with your Pro/Max subscription or an Anthropic API key
#   codex       Codex, with your ChatGPT Plus, Pro or Business plan
#   antigravity Antigravity CLI, with your Google account: free, AI Pro or Ultra (README)
#               These three are the vendors' own programs: the setup installs the one chosen and
#               signs it in. The sign-in stays with the program, never here
#   openrouter  one key for hundreds of models, some of them free
#   gemini      a free key from https://aistudio.google.com/apikey
#   ollama, lmstudio   a model running on this computer (README: it needs a long context)
#   compatible  any other OpenAI-compatible server: set REPORT_URL
REPORT_PROVIDER=claude

# The model. claude: opus (default) or sonnet. codex: OpenAI's model id, empty for Codex's
# default. antigravity: one of those the setup lists. Others: the provider's model id, as listed
# on its site, e.g. gpt-5 (openai), gemini-3.8-flash (gemini), google/gemini-3.8-flash
# (openrouter), mistral-large-latest (mistral), deepseek-v4-pro (deepseek), qwen3:32b (ollama).
REPORT_MODEL=

# The API key: Anthropic's for claude without a subscription, or the provider's (ollama and
# lmstudio need none). Empty with a subscription: if set, the key pays.
REPORT_API_KEY=
# The server's base URL, ending in /v1: required for compatible; for ollama or lmstudio only
# if they run on another machine.
REPORT_URL=
# Every provider but claude (which keeps Claude Code's own limit): the longest answer, in
# tokens. Notes for a 90-minute lecture take 20-30k, and reasoning models also spend tokens
# thinking. It must not exceed what the model allows.
REPORT_MAX_TOKENS=32000

# ---- Transcription (faster-whisper) --------------------------------------------------
# The lecture's language (Italiano or English) is chosen at every upload; the model must
# know it. The setup picks the model by free memory (README, "Where it runs"):
# large-v3-turbo, the default, needs 3.5 GB; small 2.5 GB, faster, three times the
# differences. large-v3: the most accurate, twice as slow, 5.5 GB. medium: slower, heavier
# and less accurate than large-v3-turbo. distil-* and *.en: English lectures only. A Hugging
# Face id of a CTranslate2 model works too.
WHISPER_MODEL=large-v3-turbo
# int8 is the fastest on a CPU; int8_float32 and float32 are slower.
WHISPER_COMPUTE_TYPE=int8
# CPU threads, at most the CPUs Docker has. More is not always faster: on CPUs with
# performance and efficiency cores, use the number of performance cores.
WHISPER_THREADS=4

# ---- OCR of screens without a slide (RapidOCR, PP-OCRv6, Latin alphabets included) ----
# tiny (2-8 times faster, as good on a small test), small (built in), medium (15 times
# slower). tiny and medium are downloaded on first use.
OCR_MODEL=small
OCR_THREADS=4

# ---- How it runs (docker-compose.yml) -------------------------------------------------
# A version to stay on, e.g. 1.0.0; latest follows the releases.
RECAP_VERSION=latest
# 127.0.0.1: only this computer. 0.0.0.0: your whole network — there is no login (README).
RECAP_BIND=127.0.0.1
# The port on this computer: change it if something else already uses it.
RECAP_PORT=8470
# Where lectures and the downloaded models live.
RECAP_DATA=./data
# What the container may use. RECAP_CPUS: at most the CPUs Docker has, or it does not start
# (the setup sees to it).
RECAP_CPUS=4
RECAP_MEMORY=6g
# The user the app runs as, uid:gid: the setup puts the owner of this folder, who also owns
# the data folder.
RECAP_USER=1000:1000
# Names you reach the app by, besides IP addresses and localhost, comma separated
# (e.g. mypc.local, a Tailscale name).
RECAP_HOSTNAMES=
# Once a day the app asks GitHub for the latest version, to tell you on the home page.
# off: never ask.
RECAP_UPDATE_URL=
# Your time zone, for trash dates and logs (default Europe/Rome).
#TZ=Europe/Rome

# ---- Hourly backup copy of the finished lectures (optional) -------------------------
# RECAP_BACKUP is the mount point of a NAS or a disk, which must exist; the copy goes into its
# polito-recap folder, which you create, writable by RECAP_USER.
#COMPOSE_PROFILES=backup
#RECAP_BACKUP=/mnt/nas
